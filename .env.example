# Copy to .env.local

# Port the embedded OpenCode server listens on (syrup spawns it)
OPENCODE_PORT=4096
OPENCODE_HOSTNAME=127.0.0.1

# Attach to an OpenCode server you run yourself instead of spawning one
OPENCODE_URL=

# Port for the router (OpenAI-compatible /v1) and the memory MCP server (/mcp)
SYRUP_ROUTER_PORT=4210

# Root directory the agent works in (defaults to cwd)
SYRUP_WORKSPACE=

# SQLite database file
SYRUP_DB=file:./data/syrup.db

# 32-byte base64 key used to encrypt provider API keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYRUP_VAULT_KEY=
