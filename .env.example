# Copy to .env.local

# Port the embedded OpenCode server listens on (syrup spawns it)
OPENCODE_PORT=4096
OPENCODE_HOSTNAME=127.0.0.1

# Attach to an OpenCode server you run yourself instead of spawning one
OPENCODE_URL=

# Port for the router (OpenAI-compatible /v1) and the memory MCP server (/mcp)
SYRUP_ROUTER_PORT=4210

# Root directory the agent works in (defaults to cwd)
SYRUP_WORKSPACE=

# SQLite database file
SYRUP_DB=file:./data/syrup.db

# 32-byte base64 key used to encrypt provider API keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYRUP_VAULT_KEY=

# --- Cloud mode (syrup.syedsarib.com). Set automatically on Vercel; only needed locally to test cloud mode.
# SYRUP_MODE=cloud
# AUTH_SECRET=            # npx auth secret --raw
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# DATABASE_URL=           # Neon pooled connection string
# DATABASE_URL_UNPOOLED=
# SYRUP_MASTER_KEY=       # openssl rand -base64 32; wraps every user's data key
# SYRUP_ADMIN_EMAILS=     # comma-separated Google emails that get the admin page
# SYRUP_INVITES=          # comma-separated emails allowed to sign in before the admin page manages invites
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_APP_URL=https://syrup.syedsarib.com

# Local mode: where the vault key lives (default: %APPDATA%\syrup or ~/.config/syrup)
# SYRUP_HOME=
